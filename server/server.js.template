app.get('/api/fonts/add', (req, res) => {
  if (ffInstalling) return sendErr(res, 'フォント処理がすでに進行中です', 409);
  if (!fs.existsSync(FF_SCRIPT)) return sendErr(res, 'add-fonts.sh が見つかりません', 500);
  if (!ffDirExists()) return sendErr(res, 'Fonts フォルダがありません。先に作成してください', 400);
  const n = ffCountFonts();
  if (n === 0) return sendErr(res, 'フォントファイル（ttf/otf/woff/woff2）が Fonts フォルダにありません', 400);
  if (!fs.existsSync(OO_COMPOSE_FILE)) return sendErr(res, 'OnlyOffice が未セットアップです。先に OnlyOffice をインストールしてください', 400);
  ffInstalling = true;
  res.writeHead(200, {
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache',
    Connection: 'keep-alive',
    'X-Accel-Buffering': 'no'
  });
  const send = (event, data) => res.write('event: ' + event + '\ndata: ' + JSON.stringify(data) + '\n\n');
  const log = m => send('log', { message: m });

  log('add-fonts.sh を実行します（フォント ' + n + ' 件を検出）');
  const child = spawn('bash', [FF_SCRIPT], { cwd: path.dirname(FF_SCRIPT) });
  let buf = '';
  const pump = d => {
    buf += d.toString().replace(/\r\n/g, '\n').replace(/\r/g, '\n');
    let i;
    while ((i = buf.indexOf('\n')) >= 0) {
      const line = buf.slice(0, i); buf = buf.slice(i + 1);
      const clean = line.replace(/\x1b\[[0-9;]*m/g, '');
      if (clean.trim()) log(clean);
    }
  };
  child.stdout.on('data', pump);
  child.stderr.on('data', pump);
  child.on('close', code => {
    send('done', { ok: code === 0, code, fontCount: n });
    ffInstalling = false;
  });
  child.on('error', err => {
    send('done', { ok: false, error: err.message || String(err) });
    ffInstalling = false;
  });
});

