/* ── Samba（Windows ファイル共有） ── */
const SMB_CONF = '/etc/samba/smb.conf';
const SMB_MANAGED_CONF = '/etc/samba/selfexplorer.conf';
const SMB_STATE_FILE = '/etc/samba/selfexplorer.json';
let smbInstalling = false;
let smbBusy = false;

function smbIsInstalled() {
  try {
    if (fs.existsSync('/usr/sbin/smbd') || fs.existsSync('/usr/bin/smbd')) return true;
  } catch (e) {}
  return false;
}

async function smbDaemonActive() {
  try {
    await sh('systemctl', ['is-active', '--quiet', 'smbd'], { timeout: 10000 });
    return true;
  } catch (e) {}
  try {
    const r = await sh('pgrep', ['smbd'], { timeout: 10000 });
    return r.stdout.trim().length > 0;
  } catch (e) {}
  return false;
}

async function smbAutostartEnabled() {
  try {
    const r = await sh('systemctl', ['is-enabled', 'smbd'], { timeout: 10000 });
    return r.stdout.trim() === 'enabled';
  } catch (e) {
    if (e && e.stdout && String(e.stdout).trim() === 'enabled') return true;
  }
  return false;
}

function smbReadState() {
  try {
    const j = JSON.parse(fs.readFileSync(SMB_STATE_FILE, 'utf8'));
    if (j && typeof j === 'object') return j;
  } catch (e) {}
  return null;
}

function smbWriteState(s) {
  try { fs.mkdirSync(path.dirname(SMB_STATE_FILE), { recursive: true }); } catch (e) {}
  fs.writeFileSync(SMB_STATE_FILE, JSON.stringify(s, null, 2), { mode: 0o600 });
}

function smbManagedContent() {
  try { return fs.readFileSync(SMB_MANAGED_CONF, 'utf8'); } catch (e) { return ''; }
}

function smbShareBlock(share, absPath, username, guestOk, readonly, forceUser) {
  const lines = [
    '# Generated by SelfExplorer - DO NOT EDIT',
    '# ' + new Date().toISOString(),
    '',
    '[global]',
    '  map to guest = Bad User',
    '  guest account = nobody',
    '',
    '[' + share + ']',
    '  path = ' + absPath,
    '  browseable = yes',
    '  guest ok = ' + (guestOk ? 'yes' : 'no'),
    '  read only = ' + (readonly ? 'yes' : 'no'),
    '  create mask = 0644',
    '  directory mask = 0755'
  ];
  if (forceUser) lines.push('  force user = ' + forceUser);
  if (!guestOk && username) lines.push('  valid users = ' + username);
  lines.push('');
  return lines.join('\n');
}

async function smbOwnerName(absPath) {
  try {
    const st = fs.statSync(absPath);
    const r = await sh('id', ['-nu', String(st.uid)], { timeout: 10000 });
    const name = r.stdout.trim();
    if (name) return name;
  } catch (e) {}
  return 'root';
}

async function smbSambaUserExists(username) {
  try {
    const r = await sh('pdbedit', ['-L'], { timeout: 15000 });
    return r.stdout.split('\n').some(l => l.split(':')[0] === username);
  } catch (e) { return false; }
}

async function smbEnsureSystemUser(username) {
  try {
    await sh('id', [username], { timeout: 10000 });
    return;
  } catch (e) {}
  await sh('useradd', ['-M', '-s', '/usr/sbin/nologin', username], { timeout: 30000 });
}

function smbSetPassword(username, password) {
  return new Promise((resolve, reject) => {
    const child = spawn('smbpasswd', ['-a', '-s', username]);
    let stderr = '';
    child.stderr.on('data', d => { stderr += d.toString(); });
    child.on('error', reject);
    child.on('close', code => {
      if (code !== 0) return reject(new Error('smbpasswd 失敗 (code ' + code + '): ' + stderr.trim()));
      spawn('smbpasswd', ['-e', username]).on('close', () => resolve());
    });
    child.stdin.write(password + '\n');
    child.stdin.write(password + '\n');
    child.stdin.end();
  });
}

async function smbReload() {
  try {
    await sh('smbcontrol', ['all', 'reload-config'], { timeout: 30000 });
    return;
  } catch (e) {}
  try {
    await sh('systemctl', ['reload', 'smbd'], { timeout: 30000 });
    return;
  } catch (e) {}
  await sh('systemctl', ['restart', 'smbd'], { timeout: 60000 });
}

function smbEnsureInclude() {
  let main = '';
  try { main = fs.readFileSync(SMB_CONF, 'utf8'); } catch (e) {
    throw new Error('smb.conf が見つかりません: ' + SMB_CONF);
  }
  if (!main.includes('selfexplorer.conf')) {
    fs.appendFileSync(SMB_CONF, '\n# Added by SelfExplorer\ninclude = ' + SMB_MANAGED_CONF + '\n');
  }
}

async function smbServerIps() {
  try {
    const r = await sh('hostname', ['-I'], { timeout: 10000 });
    return r.stdout.split(/\s+/).map(s => s.trim()).filter(s => s && !s.startsWith('127.'));
  } catch (e) { return []; }
}

function smbValidateFolder(folder) {
  if (!folder) throw new Error('公開するフォルダを選択してください');
  if (folder.includes('/') || folder.includes('\\') || folder === '.' || folder === '..') {
    throw new Error('フォルダ名が不正です');
  }
  if (/[\[\]\n\r]/.test(folder)) {
    throw new Error('フォルダ名に使用できない文字が含まれています');
  }
  const abs = path.join(ROOT_DIR, folder);
  if (!fs.existsSync(abs) || !fs.statSync(abs).isDirectory()) {
    throw new Error('公開するフォルダが見つかりません: ' + folder);
  }
  return abs;
}

function smbValidateUsername(username) {
  if (!/^[a-z_][a-z0-9_-]{0,31}$/i.test(username)) {
    throw new Error('ユーザー名は英数字・_-・最大32文字で入力してください');
  }
}

