app.get('/api/onlyoffice/config', (req, res) => {
  try {
    const filePath = String(req.query.path || '');
    const abs = safeResolve(filePath);
    if (!fs.existsSync(abs) || isDir(abs)) return sendErr(res, '編集できないファイルです');
    const ext = path.extname(abs).toLowerCase();
    const name = path.basename(abs);
    const key = crypto.createHash('md5').update(filePath + ':' + fs.statSync(abs).mtimeMs).digest('hex');
    const proto = publicProto(req);
    const host = publicHost(req);
    const editorUrl = ONLYOFFICE_URL || (proto + '://' + swapPort(host, OO_PORT));
    const base = docBase(req);
    const config = {
      document: {
        fileType: ext.replace('.', ''),
        key,
        title: name,
        url: base + '/api/view?path=' + encodeURIComponent(filePath),
        permissions: { edit: true, download: true, print: true }
      },
      editorConfig: {
        mode: 'edit',
        lang: 'ja-JP',
        callbackUrl: base + '/api/onlyoffice/callback?path=' + encodeURIComponent(filePath)
      },
      documentType: getDocType(ext)
    };
    if (ooActiveSecret()) config.token = signJwt(config);
    res.json({ success: true, editorUrl, config });
  } catch (e) {
    sendErr(res, e.message, e.status || 400);
  }
});

app.post('/api/onlyoffice/callback', async (req, res) => {
  try {
    const body = req.body || {};
    if (ooActiveSecret() && !verifyJwt(body.token)) {
      return res.json({ error: 1 });
    }
    if (body.status === 2 && body.url) {
      const abs = safeResolve(req.query.path);
      const resp = await fetch(body.url);
      if (!resp.ok) return res.json({ error: 1 });
      const data = Buffer.from(await resp.arrayBuffer());
      await fs.promises.writeFile(abs, data);
    }
    res.json({ error: 0 });
  } catch (e) {
    res.json({ error: 1 });
  }
});

