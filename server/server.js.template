app.get('/api/samba/install', (req, res) => {
  if (smbInstalling) return sendErr(res, 'セットアップがすでに進行中です', 409);
  if (smbIsInstalled()) return sendErr(res, 'Samba はすでにインストールされています', 400);
  smbInstalling = true;
  res.writeHead(200, {
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache',
    Connection: 'keep-alive',
    'X-Accel-Buffering': 'no'
  });
  const send = (event, data) => res.write('event: ' + event + '\ndata: ' + JSON.stringify(data) + '\n\n');
  const log = m => send('log', { message: m });
  (async () => {
    try {
      log('Samba のセットアップを開始します');
      log('パッケージリストを更新中...');
      await sh('apt-get', ['update'], { timeout: 600000 });
      log('Samba をインストール中...（数分かかる場合があります）');
      await sh('bash', ['-c', 'DEBIAN_FRONTEND=noninteractive apt-get install -y samba'], { timeout: 1800000 });
      log('smbd を有効化・起動中...');
      try {
        await sh('systemctl', ['enable', '--now', 'smbd'], { timeout: 60000 });
      } catch (e) {
        await sh('service', ['smbd', 'start'], { timeout: 60000 }).catch(() => {});
      }
      smbEnsureInclude();
      log('設定ファイルの include を確認しました');
      log('Samba のインストールが完了しました！');
      send('done', { ok: true });
    } catch (e) {
      const detail = (e.stderr || e.stdout || e.message || String(e)).toString().slice(0, 500);
      send('done', { ok: false, error: detail });
    } finally {
      smbInstalling = false;
    }
  })();
});

app.post('/api/samba/start', async (req, res) => {
  if (smbBusy) return sendErr(res, 'すでに処理中です', 409);
  try {
    if (!smbIsInstalled()) return sendErr(res, 'Samba がインストールされていません');
    const body = req.body || {};
    const folder = String(body.folder || '').trim();
    const guestOk = !!body.guestOk;
    const readonly = !!body.readonly;
    const username = String(body.username || '').trim();
    const password = String(body.password || '');
    const abs = smbValidateFolder(folder);
    const share = folder;
    if (!guestOk) {
      if (!username) return sendErr(res, 'ユーザー名を入力してください（匿名の場合は匿名アクセスを有効にしてください）');
      smbValidateUsername(username);
      const isNew = !(await smbSambaUserExists(username));
      if (isNew && !password) return sendErr(res, '新規ユーザーのためパスワードを入力してください');
    }
    smbBusy = true;
    try {
      if (!guestOk) {
        await smbEnsureSystemUser(username);
        if (password) await smbSetPassword(username, password);
        else if (!(await smbSambaUserExists(username))) {
          return sendErr(res, 'パスワードを入力してください');
        }
      }
      const forceUser = await smbOwnerName(abs);
      smbEnsureInclude();
      fs.writeFileSync(SMB_MANAGED_CONF, smbShareBlock(share, abs, username, guestOk, readonly, forceUser));
      try {
        await sh('testparm', ['-s'], { timeout: 30000 });
      } catch (e) {
        throw new Error('smb.conf の検証に失敗しました: ' + ((e.stderr || e.message || '').toString().slice(0, 300)));
      }
      try { fs.chmodSync(abs, 0o755); } catch (e) {}
      try {
        await sh('systemctl', ['enable', '--now', 'smbd'], { timeout: 60000 });
      } catch (e) {}
      await smbReload();
      smbWriteState({ folder, share, username: guestOk ? '' : username, guestOk, readonly, enabled: true });
      const ips = await smbServerIps();
      res.json({ success: true, folder, share, guestOk, readonly, ips });
    } finally {
      smbBusy = false;
    }
  } catch (e) {
    smbBusy = false;
    sendErr(res, e.message, e.status || 500);
  }
});

app.post('/api/samba/stop', async (req, res) => {
  if (smbBusy) return sendErr(res, 'すでに処理中です', 409);
  try {
    if (!smbIsInstalled()) return sendErr(res, 'Samba がインストールされていません');
    smbBusy = true;
    try {
      const prev = smbReadState() || {};
      fs.writeFileSync(SMB_MANAGED_CONF, '# Managed by SelfExplorer - no shares configured\n');
      await smbReload().catch(() => {});
      smbWriteState({
        folder: prev.folder || '',
        share: prev.share || '',
        username: prev.username || '',
        guestOk: !!prev.guestOk,
        readonly: !!prev.readonly,
        enabled: false
      });
      res.json({ success: true });
    } finally {
      smbBusy = false;
    }
  } catch (e) {
    smbBusy = false;
    sendErr(res, e.message, e.status || 500);
  }
});

app.post('/api/samba/autostart', async (req, res) => {
  try {
    if (!smbIsInstalled()) return sendErr(res, 'Samba がインストールされていません');
    const on = !(req.body && req.body.enabled === false);
    await sh('systemctl', [on ? 'enable' : 'disable', 'smbd'], { timeout: 30000 });
    res.json({ success: true, autostart: on });
  } catch (e) {
    sendErr(res, e.message, e.status || 500);
