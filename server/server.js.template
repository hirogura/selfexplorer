});

app.post('/api/delete-batch', (req, res) => {
  const paths = Array.isArray(req.body.paths) ? req.body.paths : [];
  for (const p of paths) {
    try { fs.rmSync(safeResolve(p), { recursive: true, force: true }); } catch (e) {}
