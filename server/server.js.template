let upUpdating = false;
/* server.js.template の変更を、実行中の server.js に再生成して反映する。
   server/server.js はシークレットを含むため git 管理対象外で、
   git pull で更新されるのは server.js.template のみ。
   インストール時と同じ置換（PORT / OO_PORT / ROOT_DIR / OO_SECRET）を、
   現在の設定値（既存 server.js から抽出）を保持したまま再適用する。 */
function regenerateServerFromTemplate() {
  const tpl = path.join(__dirname, 'server.js.template');
  const out = path.join(__dirname, 'server.js');
  let cur = '';
  try { cur = fs.readFileSync(out, 'utf8'); } catch (e) {}
  const grab = re => { const m = cur.match(re); return m ? m[1] : ''; };
  const port      = grab(/process\.env\.PORT \|\| '([^']*)'/)        || process.env.PORT || '3346';
  const ooPort    = grab(/process\.env\.ONLYOFFICE_PORT \|\| '([^']*)'/) || process.env.ONLYOFFICE_PORT || '3322';
  const rootDir   = grab(/process\.env\.ROOT_DIR \|\| '([^']*)'/)    || process.env.ROOT_DIR || '/opt/lxd-data';
  const secret    = ooCurrentServerSecret();
  let src;
  try { src = fs.readFileSync(tpl, 'utf8'); } catch (e) { return false; }
  /* プレースホルダトークン(例: アンダースコア2つ+PORT+アンダースコア2つ)は文字列連結で構成する。
     インストール時のグローバル sed で関数内の
     リテラル文字列が書き換えられるのを防ぐため。 */
  const tok = k => '_' + '_' + k + '_' + '_';
  src = src.split(tok('PORT')).join(port)
           .split(tok('OO_PORT')).join(ooPort)
           .split(tok('ROOT_DIR')).join(rootDir)
           .split(tok('OO_SECRET')).join(secret);
  try {
    fs.writeFileSync(out, src);
    return true;
  } catch (e) { return false; }
}

app.get('/api/update', (req, res) => {
  if (upUpdating) return sendErr(res, 'アップデートがすでに進行中です', 409);
  upUpdating = true;
  res.writeHead(200, {
    'Content-Type': 'text/event-stream',
    'Cache-Control': 'no-cache',
    Connection: 'keep-alive',
    'X-Accel-Buffering': 'no'
  });
  const send = (event, data) => res.write('event: ' + event + '\ndata: ' + JSON.stringify(data) + '\n\n');
  const log = m => send('log', { message: m });
  const repoDir = path.join(__dirname, '..');
  (async () => {
    let oldHead = '';
    try { oldHead = (await sh('git', ['rev-parse', 'HEAD'], { cwd: repoDir })).stdout.trim(); } catch (e) {}
    log('GitHub から最新版を取得します (git pull --ff-only)');
    /* 旧インストーラが public/js/app.js の ROOT_PREFIX を sed 書き換えしていた環境では
       git pull がローカル変更で失敗するため、設定差分のみを事前に破棄して回復させる。
       v1.4.0 以降は /api/config で取得するため書き換えは不要。 */
    try {
      await sh('git', ['checkout', '--', 'public/js/app.js'], { cwd: repoDir, timeout: 20000 });
    } catch (e) {}
    const child = spawn('git', ['pull', '--ff-only'], { cwd: repoDir });
    let buf = '';
    const pump = d => {
      buf += d.toString().replace(/\r\n/g, '\n').replace(/\r/g, '\n');
      let i;
      while ((i = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, i); buf = buf.slice(i + 1);
        if (line.trim()) log(line);
      }
    };
    child.stdout.on('data', pump);
    child.stderr.on('data', pump);
    child.on('close', async code => {
      if (code !== 0) { send('done', { ok: false, error: 'git pull 失敗 (code ' + code + ')。ローカルの変更を確認してください' }); upUpdating = false; return; }
      let changed = [];
      try {
        changed = (await sh('git', ['diff', '--name-only', oldHead + '..HEAD'], { cwd: repoDir })).stdout.split('\n').filter(Boolean);
      } catch (e) {}
      const serverChanged = changed.some(f => f.startsWith('server/'));
      if (serverChanged) {
        log('サーバー側の変更があります。server.js を再生成します...');
        regenerateServerFromTemplate();
      }
      const needRestart = serverChanged;
      log(changed.length ? '更新ファイル: ' + changed.length + ' 件' : '更新はありません');
      if (needRestart) log('サーバー側の変更があるため「再起動」が必要です');
      send('done', { ok: true, changedFiles: changed.length, needRestart });
      upUpdating = false;
    });
    child.on('error', err => {
      send('done', { ok: false, error: err.message || String(err) });
      upUpdating = false;
    });
  })();
});

