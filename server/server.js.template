/* Nesting の自動変更はホスト側 lxc CLI が利用できる場合のみ試みる */
async function ooTryEnableNesting(name) {
  let names = null;
  try {
    names = (await sh('lxc', ['list', '--format', 'csv', '-c', 'n'], { timeout: 15000 })).stdout.split('\n').map(s => s.trim()).filter(Boolean);
  } catch (e) { return { result: 'no-cli' }; }
  if (!name || !names.includes(name)) return { result: 'not-found' };
  try {
    await sh('lxc', ['config', 'set', name, 'security.nesting', 'true'], { timeout: 20000 });
    return { result: 'set' };
  } catch (e) { return { result: 'fail', error: e.message || String(e) }; }
}

const app = express();
app.use(express.json({ limit: '20mb' }));

function sendErr(res, msg, status) {
  return res.status(status || 400).json({ success: false, error: msg });
}

function toRel(abs) {
  return path.relative(ROOT_DIR, abs).split(path.sep).join('/');
}

function safeResolve(p) {
  const abs = path.resolve(ROOT_DIR, String(p || ''));
  const check = path.relative(ROOT_DIR, abs);
  if (check === '..' || check.startsWith('..' + path.sep) || path.isAbsolute(check)) {
    const e = new Error('Invalid path');
    e.status = 400;
    throw e;
  }
  return abs;
}

function isDir(p) {
  return fs.statSync(p).isDirectory();
}

async function hasChildren(dir) {
  try {
    const entries = await fs.promises.readdir(dir);
    for (const name of entries) {
      if (fs.statSync(path.join(dir, name)).isDirectory()) return true;
    }
  } catch (e) {}
  return false;
}

function b64url(buf) {
  return Buffer.from(buf).toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

function signJwt(payload) {
  const header = b64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));
  const body = b64url(JSON.stringify(payload));
  const sig = crypto.createHmac('sha256', ooActiveSecret()).update(header + '.' + body).digest();
  return header + '.' + body + '.' + b64url(sig);
}

function verifyJwt(token) {
  const parts = String(token || '').split('.');
  if (parts.length !== 3) return null;
  const [h, b, s] = parts;
  const expected = crypto.createHmac('sha256', ooActiveSecret()).update(h + '.' + b).digest();
  let sig;
  try { sig = Buffer.from(s, 'base64url'); } catch (e) { return null; }
  if (expected.length !== sig.length || !crypto.timingSafeEqual(expected, sig)) return null;
  try { return JSON.parse(Buffer.from(b, 'base64url').toString('utf8')); } catch (e) { return null; }
}

function getDocType(ext) {
  const map = {
    '.docx': 'word', '.doc': 'word', '.odt': 'word', '.rtf': 'word', '.txt': 'word', '.md': 'word',
    '.xlsx': 'cell', '.xls': 'cell', '.ods': 'cell', '.csv': 'cell',
    '.pptx': 'slide', '.ppt': 'slide', '.odp': 'slide'
  };
  return map[ext.toLowerCase()] || 'word';
}

function isLocalHost(host) {
  return /^(127\.0\.0\.1|localhost)(:|$)/i.test(host);
}

function publicProto(req) {
  const p = req.headers['x-forwarded-proto'];
  if (p) return p.split(',')[0].trim();
  return isLocalHost(publicHost(req)) ? 'http' : 'https';
}

function publicHost(req) {
  const h = req.headers['x-forwarded-host'];
  if (h) return h.split(',')[0].trim();
  return req.headers.host || ('127.0.0.1:' + PORT);
}

function swapPort(host, port) {
  if (/:\d+$/.test(host)) return host.replace(/:\d+$/, ':' + port);
  return host + ':' + port;
}

function docBase(req) {
  if (PUBLIC_URL) return PUBLIC_URL;
  const host = publicHost(req);
  if (isLocalHost(host)) return 'http://host.docker.internal:' + PORT;
  return publicProto(req) + '://' + host;
}

function streamFile(file, res) {
  const st = fs.statSync(file);
  res.setHeader('Content-Type', mime.lookup(file) || 'application/octet-stream');
  res.setHeader('Content-Length', st.size);
  fs.createReadStream(file).on('error', () => res.status(404).end()).pipe(res);
}

app.use(express.static(path.join(__dirname, '..', 'public')));

app.get('/api/browse', async (req, res) => {
  try {
    const dir = safeResolve(req.query.path);
    if (!isDir(dir)) return sendErr(res, 'フォルダではありません');
    const entries = await fs.promises.readdir(dir, { withFileTypes: true });
    const items = [];
    for (const ent of entries) {
      const full = path.join(dir, ent.name);
      let st;
      try { st = await fs.promises.stat(full); } catch (e) { continue; }
      items.push({
        name: ent.name,
        path: toRel(full),
        isDirectory: ent.isDirectory(),
        size: ent.isDirectory() ? 0 : st.size,
        extension: ent.isDirectory() ? '' : path.extname(ent.name).toLowerCase(),
        modified: st.mtime.toISOString(),
        hasChildren: ent.isDirectory() ? await hasChildren(full) : false
      });
    }
    res.json({ success: true, items });
  } catch (e) {
    sendErr(res, e.message, e.status || 400);
  }
});

app.get('/api/tree', async (req, res) => {
  try {
    const dir = safeResolve(req.query.path);
    const entries = await fs.promises.readdir(dir, { withFileTypes: true });
    const items = [];
    for (const ent of entries) {
      if (!ent.isDirectory()) continue;
      const full = path.join(dir, ent.name);
      items.push({ name: ent.name, path: toRel(full), hasChildren: await hasChildren(full) });
    }
    res.json({ success: true, items });
  } catch (e) {
    sendErr(res, e.message, e.status || 400);
  }
});

app.get('/api/thumbnail', (req, res) => {
  try {
    const file = safeResolve(req.query.path);
    const type = mime.lookup(file) || 'application/octet-stream';
    if (!type.startsWith('image/')) return sendErr(res, '画像ではありません', 415);
    res.setHeader('Content-Type', type);
    fs.createReadStream(file).on('error', () => res.status(404).end()).pipe(res);
  } catch (e) {
    sendErr(res, e.message, e.status || 400);
