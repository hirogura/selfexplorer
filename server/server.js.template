async function tailnetHostname() {
  try {
    const out = (await sh('tailscale', ['whoami', '--json'], { timeout: 10000 })).stdout;
    const j = JSON.parse(out);
    if (j && j.Node && j.Node.Name) return j.Node.Name.replace(/\.$/, '');
  } catch (e) {}
  try {
    const j = JSON.parse((await sh('tailscale', ['status', '--self', '--json'], { timeout: 10000 })).stdout);
    if (j && j.Self && j.Self.DNSName) return j.Self.DNSName.replace(/\.$/, '');
  } catch (e) {}
  return '';
}

async function startWebServer(folder) {
  if (webServerStarting) throw new Error('すでに処理中です');
  if (webServer && webFolder === folder) return null;
  if (webServer && webFolder !== folder) {
    await stopWebServer();
  }
  const abs = path.join(ROOT_DIR, folder);
  if (!fs.existsSync(abs) || !fs.statSync(abs).isDirectory()) {
    throw new Error('公開するフォルダが見つかりません: ' + folder);
  }
  webServerStarting = true;
  try {
    webFolder = folder;
    refreshWebStatic();
    if (!webServer) {
      const srv = http.createServer(webExpress);
      await new Promise((resolve, reject) => {
        srv.once('error', reject);
        srv.listen(WEB_SERVE_PORT, '127.0.0.1', resolve);
      });
      webServer = srv;
    }
    // Tailscale Serve で 3358 を公開
    const serveStatus = (await sh('tailscale', ['serve', 'status'], { timeout: 15000 }).catch(() => ({ stdout: '' }))).stdout || '';
    if (new RegExp(':' + WEB_SERVE_PORT + '(\\b|$)').test(serveStatus)) {
      // 既に登録済みなら設定を付け替え
      await sh('tailscale', ['serve', '--https=' + WEB_SERVE_PORT, 'off'], { timeout: 20000 }).catch(() => {});
    }
    await sh('tailscale', ['serve', '--bg', '--https=' + WEB_SERVE_PORT, 'http://127.0.0.1:' + WEB_SERVE_PORT], { timeout: 30000 });
    try { webWriteSaved(folder, webReadSaved().autostart); } catch (e) {}
    return { folder, port: WEB_SERVE_PORT };
  } catch (e) {
    webFolder = '';
    throw e;
  } finally {
    webServerStarting = false;
  }
}

async function stopWebServer() {
  if (webServerStarting) throw new Error('すでに処理中です');
  webFolder = '';
  if (webServer) {
    const srv = webServer;
    webServer = null;
    await new Promise(resolve => srv.close(() => resolve()));
  }
  await sh('tailscale', ['serve', '--https=' + WEB_SERVE_PORT, 'off'], { timeout: 20000 }).catch(() => {});
  return true;
}

