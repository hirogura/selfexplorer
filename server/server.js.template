function ffCountFonts() {
  const re = /\.(ttf|otf|woff2?)$/i;
  let n = 0;
  try {
    for (const e of fs.readdirSync(FONT_DIR, { withFileTypes: true })) {
      if (e.isFile() && re.test(e.name)) n++;
      else if (e.isDirectory()) {
        try {
          for (const e2 of fs.readdirSync(path.join(FONT_DIR, e.name), { withFileTypes: true })) {
            if (e2.isFile() && re.test(e2.name)) n++;
          }
        } catch (err) {}
      }
    }
  } catch (e) {}
  return n;
}

