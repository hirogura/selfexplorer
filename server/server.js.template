async function ooComposeCommand() {
  try { await sh('docker', ['compose', 'version'], { timeout: 20000 }); return { cmd: 'docker', baseArgs: ['compose'] }; }
  catch (e) {}
  try { await sh('docker-compose', ['version'], { timeout: 20000 }); return { cmd: 'docker-compose', baseArgs: [] }; } catch (e) {}
  throw new Error('docker compose プラグインが見つかりません');
}

async function ooDockerDaemonReady(deadlineMs) {
  const deadline = Date.now() + deadlineMs;
  while (Date.now() < deadline) {
    try { await sh('docker', ['info'], { timeout: 10000 }); return true; } catch (e) {}
    await new Promise(r => setTimeout(r, 3000));
  }
  return false;
}

function ooReadComposeSecret() {
  try {
    const m = fs.readFileSync(OO_COMPOSE_FILE, 'utf8').match(/JWT_SECRET:\s*"([^"]+)"/);
    return m ? m[1] : '';
  } catch (e) { return ''; }
}

/* 実行時に有効なシークレットを解決: 環境変数 > コンテナ側 (docker-compose.yml) > 既定値 */
function ooActiveSecret() {
  if (process.env.ONLYOFFICE_SECRET) return ONLYOFFICE_SECRET;
  return ooReadComposeSecret() || ONLYOFFICE_SECRET;
}

function ooServerSecretFile() {
  return path.join(__dirname, 'server.js');
}

function ooCurrentServerSecret() {
  try {
    const m = fs.readFileSync(ooServerSecretFile(), 'utf8')
      .match(/const ONLYOFFICE_SECRET = process\.env\.ONLYOFFICE_SECRET \|\| '([^']*)'/);
    return m ? m[1] : ONLYOFFICE_SECRET;
  } catch (e) { return ONLYOFFICE_SECRET; }
}

function ooSetServerSecret(secret) {
  const file = ooServerSecretFile();
  let src = fs.readFileSync(file, 'utf8');
  src = src.replace(/const ONLYOFFICE_SECRET = process\.env\.ONLYOFFICE_SECRET \|\| '[^']*'/,
    "const ONLYOFFICE_SECRET = process.env.ONLYOFFICE_SECRET || '" + secret + "'");
  fs.writeFileSync(file, src);
}

function ooEditorUrl(req) {
  if (ONLYOFFICE_URL) return ONLYOFFICE_URL;
  const proto = publicProto(req);
  const host = publicHost(req);
  return proto + '://' + swapPort(host, OO_PORT);
}

/* ── 実行環境チェック（LXD コンテナ / Nesting 判定） ── */
async function ooDevLxdInfo() {
  try {
    if (!fs.existsSync('/dev/lxd/sock')) return null;
    const out = (await sh('curl', ['-sf', '--max-time', '3', '--unix-socket', '/dev/lxd/sock', 'http://local/1.0'], { timeout: 8000 })).stdout;
    return JSON.parse(out);
  } catch (e) { return null; }
}

function ooReadAttrCurrent() {
  for (const f of ['/proc/self/attr/current', '/proc/self/attr/apparmor/current']) {
    try { const v = fs.readFileSync(f, 'utf8').trim(); if (v) return v; } catch (e) {}
  }
  return '';
}

function ooHasCapSysAdmin() {
  try {
    const m = fs.readFileSync('/proc/self/status', 'utf8').match(/^CapEff:\s*([0-9a-f]+)/m);
    if (!m) return null;
    return ((BigInt('0x' + m[1]) >> BigInt(21)) & BigInt(1)) === BigInt(1);
  } catch (e) { return null; }
}

async function ooEnvCheck() {
  let virt = 'none';
  try { virt = (await sh('systemd-detect-virt', ['-c'], { timeout: 5000 })).stdout.trim(); } catch (e) {}
  let isLxc = false;
  if (virt === 'lxc' || virt === 'lxd') isLxc = true;
  else {
    try { if (/container=(lxc|lxd)/.test(fs.readFileSync('/proc/1/environ', 'utf8'))) { isLxc = true; virt = 'lxc'; } } catch (e) {}
  }
  if (!isLxc && fs.existsSync('/dev/lxd/sock')) { isLxc = true; virt = 'lxc'; }
  let containerName = '';
  let hostName = '';
  if (isLxc) {
    const d = await ooDevLxdInfo();
    if (d && d.location) hostName = d.location;
    try { containerName = fs.readFileSync('/etc/hostname', 'utf8').trim(); } catch (e) {}
  }
  const attr = ooReadAttrCurrent();
  const nestingProfile = attr.includes(':lxd-nesting:');
  const capSysAdmin = ooHasCapSysAdmin();
  const nestingOk = isLxc ? (nestingProfile || capSysAdmin === true) : true;
  return { virt, isLxc, containerName, hostName, nestingProfile, capSysAdmin, nestingOk };
}

